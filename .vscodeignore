# This is a keymap-only extension: the shipped package needs the manifest,
# icon, and the docs the Marketplace renders. Everything below is repo-side
# tooling that end users never load.

# CI and repo templates
.github/**

# Editor workspace config
.vscode/**

# Agent instructions
CLAUDE.md

# Tests are not part of the extension
test/**

# Repo-only dotfiles
.gitignore

# Contributor docs; README links to these are rewritten to GitHub URLs at
# package time, so excluding the files does not break the Marketplace page.
docs/HOW-TO-CREATE-NEW-SHORTCUT.md
docs/TESTING.md
