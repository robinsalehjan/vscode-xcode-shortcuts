# This is a keymap-only extension: the shipped package needs the manifest,
# icon, and the docs the Marketplace renders. Everything below is repo-side
# tooling that end users never load.

# CI and repo templates
.github/**

# Editor workspace config
.vscode/**

# Agent instructions
CLAUDE.md

# Tests are not part of the extension
test/**

# Repo-only dotfiles
.gitignore

# Docs live on GitHub, not in the package. Relative README links are
# rewritten to absolute GitHub URLs at package time, so the Marketplace
# page is unaffected. SHORTCUTS.md stays in the repo: the structural
# tests check it against the keybindings in package.json.
docs/**
